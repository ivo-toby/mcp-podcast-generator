# Required: Google AI Studio API key
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Output directory (mapped volume in Docker)
OUTPUT_DIR=/output

# Temporary processing directory
TEMP_DIR=/tmp/podcast-gen

# Server port
PORT=3000

# Log level (info, debug, warn, error)
LOG_LEVEL=info

# --- Cloudflare R2 (S3-compatible object storage) ---
# R2 uses S3 protocol but has different endpoint format.
# 1. Go to Cloudflare Dashboard → Zero Trust → R2 → API Tokens
# 2. Create a token with "R2 Objects Read & Write" scope
# 3. Replace <account-id> with your Cloudflare account ID (found in dashboard URL)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=podcast-audio
S3_PUBLIC_URL=https://cdn.example.com
S3_FORCE_PATH_STYLE=true
S3_REGION=auto

# --- RSS Feed ---
RSS_FEED_URL=https://cdn.example.com/podcast.xml
PODCAST_TITLE=My Podcast
PODCAST_DESCRIPTION=A sample podcast description.
PODCAST_LINK=https://example.com/podcast
PODCAST_AUTHOR=Podcast Author
PODCAST_LANGUAGE=en-us
PODCAST_CATEGORIES=Technology,Podcasts

# --- Public URL (required for RSS-only mode) ---
PUBLIC_URL=https://example.com
