# Required: Google AI Studio API key
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Output directory (mapped volume in Docker)
OUTPUT_DIR=/output

# Temporary processing directory
TEMP_DIR=/tmp/podcast-gen

# Server port
PORT=3000

# Log level (info, debug, warn, error)
LOG_LEVEL=info

# MCP operation-tool exposure. The default exposes generate_and_publish and
# get_job_status. Only the literal "true" also exposes generate_podcast and
# publish_podcast. Changing this requires a server restart.
EXPOSE_SEPARATE_TOOLS=false

# --- S3-compatible object storage (optional) ---
# Leave the five required values blank to disable S3. If any is set, all five
# must be set. For Cloudflare R2, replace <account-id> and supply an R2 token.
# R2 uses the S3 protocol. Create a token with "R2 Objects Read & Write" scope
# in the Cloudflare dashboard, then set S3_ENDPOINT to the account endpoint.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
S3_REGION=us-east-1
# Example R2 values (uncomment and replace placeholders as a complete set):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET=podcast-audio
# S3_PUBLIC_URL=https://cdn.example.com
# S3_REGION=auto

# --- RSS Feed (optional) ---
# Set RSS_FEED_URL and all required podcast metadata to enable RSS updates.
RSS_FEED_URL=
PODCAST_TITLE=
PODCAST_DESCRIPTION=
PODCAST_LINK=
PODCAST_AUTHOR=
PODCAST_LANGUAGE=en-us
PODCAST_CATEGORIES=Technology,Podcasts

# --- Public URL (required for RSS-only mode) ---
PUBLIC_URL=http://localhost:3000
