# Required: Google AI Studio API key
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Output directory (mapped volume in Docker)
OUTPUT_DIR=/output

# Temporary processing directory
TEMP_DIR=/tmp/podcast-gen

# Server port
PORT=3000

# Log level (info, debug, warn, error)
LOG_LEVEL=info

# --- S3 Storage (optional) ---
# Uncomment all 5 required vars together; omit all to disable S3.
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=false

# --- RSS Feed (optional) ---
# Uncomment all to enable RSS publishing.
# RSS_FEED_URL=https://cdn.example.com/podcast.xml
# PODCAST_TITLE=My Podcast
# PODCAST_DESCRIPTION=A sample podcast description.
# PODCAST_LINK=https://example.com/podcast
# PODCAST_AUTHOR=Podcast Author
# PODCAST_LANGUAGE=en-us
# PODCAST_CATEGORIES=Technology,Podcasts

# --- Public URL (required for RSS-only mode) ---
# When RSS is configured without S3, PUBLIC_URL must point to a
# public hostname (not localhost/127.0.0.1/::1).
# PUBLIC_URL=https://cdn.example.com
