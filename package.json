{
  "name": "mcp-podcast-generator",
  "version": "1.0.0",
  "description": "MCP server that generates podcast audio from scripts using Google Gemini TTS and FFmpeg",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/smoke-async-jobs.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/node-http-handler": "^3.370.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "xml2js": "^0.6.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/pino": "^7.0.4",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.1.2",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.2"
  }
}
